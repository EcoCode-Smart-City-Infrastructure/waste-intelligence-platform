# WIN OS build of the pre-existing AI Copilot Service.
#
# The original copilot_service/Dockerfile assumes a repo-root build context:
# its builder copies the repo-root requirements.txt (the MCP server's, not
# this service's) and its final stage copies copilot_service/ and
# .env.example from the repo root. WIN OS builds it with the service
# directory itself as the context (see win-os/compose.yaml), so here the
# builder installs this service's own requirements.txt, the final stage
# copies the package from the context root, and the .env.example copy is
# dropped: example config does not belong in the image; the service takes
# its configuration from the environment Compose provides. The original
# Dockerfile is untouched.
#
# Multi-stage build for production deployment

# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# Production stage
FROM python:3.11-slim

WORKDIR /app

# Create non-root user
RUN useradd --create-home --shell /bin/bash appuser

# Copy installed packages from builder
COPY --from=builder /root/.local /home/appuser/.local

# Make sure scripts in .local are usable
ENV PATH=/home/appuser/.local/bin:$PATH

# Copy application code: the context IS the copilot_service package
# directory, so it lands as /app/copilot_service/ (the module the CMD runs).
COPY . /app/copilot_service/

# Create logs directory
RUN mkdir -p /app/logs && chown appuser:appuser /app/logs

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Switch to non-root user
USER appuser

# Set working directory
WORKDIR /app

# Expose port
EXPOSE 8004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8004/health').raise_for_status()" || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "copilot_service.api.app:app", "--host", "0.0.0.0", "--port", "8004"]
