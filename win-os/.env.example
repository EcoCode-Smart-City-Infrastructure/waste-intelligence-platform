# WIN OS environment template. Copy to .env and fill in real values.
# NEVER commit a real .env. Placeholders only.
WIN_ENVIRONMENT=development
WIN_POSTGRES_USER=winos
WIN_POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
WIN_POSTGRES_DB=winos
WIN_POSTGRES_PORT=5433
WIN_API_PORT=8080
# API keys: comma-separated key:role:org_id entries.
# Roles: platform_admin org_admin operations_manager analyst operator viewer integration
WIN_OS_KEYS=dev-admin-key:platform_admin:org-dev,dev-viewer-key:viewer:org-dev
WIN_CORS_ORIGINS=https://ecocode-smart-city-infrastructure.github.io,http://localhost:3000
WIN_GRAFANA_PASSWORD=change-me
# Optional AI providers (Copilot reports unavailable when both are empty)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional external data
SOCRATA_APP_TOKEN=
# Edge profile only: integration-role key for the MQTT bridge (see win-os/apps/edge)
WIN_EDGE_API_KEY=
