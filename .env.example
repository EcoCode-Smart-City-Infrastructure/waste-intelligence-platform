# WIN OS - Waste Intelligence Network Operating System
# Environment Configuration

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waste
DB_USER=postgres
DB_PASSWORD=postgres

# Database connection URL (used by hub_layer and other services)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waste

# ============================================================================
# HUB LAYER API
# ============================================================================

# Hub Layer API server configuration
HUB_HOST=0.0.0.0
HUB_PORT=5000
HUB_DEBUG=False

# ============================================================================
# WEB APPLICATION
# ============================================================================

# Web application configuration
WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_DEBUG=False

# ============================================================================
# API SERVICE
# ============================================================================

# Main API service configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_WORKERS=4

# API authentication
API_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
API_JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-hex-32
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRY_HOURS=24

# ============================================================================
# CONTROL CENTER
# ============================================================================

# Control Center service configuration
CONTROL_CENTER_HOST=0.0.0.0
CONTROL_CENTER_PORT=8001
CONTROL_CENTER_DEBUG=False

# ============================================================================
# ANALYTICS SERVICE
# ============================================================================

# Analytics service configuration
ANALYTICS_HOST=0.0.0.0
ANALYTICS_PORT=8002
ANALYTICS_DEBUG=False

# ============================================================================
# AI COPILOT SERVICE
# ============================================================================

# AI Copilot service configuration
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8004
COPILOT_DEBUG=False

# Copilot service URL for proxy
COPILOT_SERVICE_URL=http://copilot-service:8004

# AI Model Provider Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# AI Model Configuration
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=120

# ============================================================================
# MQTT BRIDGE
# ============================================================================

# MQTT Bridge service configuration
MQTT_BRIDGE_HOST=0.0.0.0
MQTT_BRIDGE_PORT=8005
MQTT_BRIDGE_DEBUG=False

# MQTT Broker configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_CLEAN_SESSION=True

# MQTT Topics
MQTT_TELEMETRY_TOPIC=sensors/+/telemetry
MQTT_COMMAND_TOPIC=commands/+
MQTT_STATUS_TOPIC=status/+

# ============================================================================
# TELEMETRY SIMULATION
# ============================================================================

SIMULATION_ENABLED=True
SIMULATION_INTERVAL_SECONDS=60
SIMULATION_NUM_BINS=10
SIMULATION_NUM_SENSORS=20

# ============================================================================
# DATA INGESTION
# ============================================================================

INGESTION_ENABLED=True
INGESTION_INTERVAL_MINUTES=60
INGESTION_WORKERS=4
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_DELAY_SECONDS=60

# External data sources
NYC_OPEN_DATA_API_KEY=
DSNY_API_KEY=
WEATHER_API_KEY=

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================

AUTH_ENABLED=True
AUTH_PROVIDER=local
AUTH_JWT_SECRET=your-auth-jwt-secret-here-generate-with-openssl-rand-hex-32
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRY_HOURS=24
AUTH_REFRESH_TOKEN_EXPIRY_DAYS=7

# Session configuration
SESSION_SECRET=your-session-secret-here-generate-with-openssl-rand-hex-32
SESSION_COOKIE_NAME=win_os_session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=lax

# ============================================================================
# MULTI-TENANCY
# ============================================================================

TENANCY_ENABLED=True
DEFAULT_TENANT=demo-tenant
TENANT_IDENTIFIER=tenant_id

# ============================================================================
# SECURITY
# ============================================================================

SECURITY_CSRF_ENABLED=True
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
SECURITY_CORS_HEADERS=Content-Type,Authorization,X-Request-ID,X-Tenant-ID

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

MONITORING_ENABLED=True
MONITORING_PORT=9090
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=True
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/win-os

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================

BACKUP_ENABLED=True
BACKUP_DIR=/var/backups/win-os
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# DOCKER & CONTAINERIZATION
# ============================================================================

DOCKER_REGISTRY=localhost:5000
DOCKER_NETWORK=win-os-network
CONTAINER_CPU_LIMIT=1.0
CONTAINER_MEMORY_LIMIT=1g

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

DEVELOPMENT_MODE=True
HOT_RELOAD=True
DEBUG_PORT_API=5678
DEBUG_PORT_WEB=3001

# ============================================================================
# TESTING
# ============================================================================

TEST_DB_NAME=waste_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_COVERAGE=True
TEST_COVERAGE_DIR=.coverage
TEST_REPORT_DIR=test-reports

# ============================================================================
# PERFORMANCE
# ============================================================================

CACHE_ENABLED=True
CACHE_BACKEND=redis
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=
CACHE_EXPIRY_SECONDS=3600
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_RESULTS=1000

# ============================================================================
# NOTIFICATIONS
# ============================================================================

NOTIFICATION_ENABLED=True
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=win-os@localhost
SLACK_WEBHOOK_URL=

# ============================================================================
# GEOSPATIAL
# ============================================================================

GEO_DEFAULT_CRS=EPSG:4326
GEO_DEFAULT_BOUNDS=-74.25909,40.477399,-73.700181,40.917556
GEO_MAX_ZOOM=18
GEO_MIN_ZOOM=10
MAP_PROVIDER=maplibre
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_ANALYTICS=True
FEATURE_COPILOT=True
FEATURE_MQTT=True
FEATURE_SIMULATION=True
FEATURE_DIGITAL_TWIN=False
FEATURE_EDGE=False

# ============================================================================
# NOTES
# ============================================================================

# 1. Generate secrets using:
#    openssl rand -hex 32 (for 32-byte hex strings)
#
# 2. For production, set all SECRET, KEY, and PASSWORD variables
#    to strong, unique values
#
# 3. Never commit this file with actual secrets - use .gitignore
#
# 4. For Docker deployments, use Docker secrets or environment files
