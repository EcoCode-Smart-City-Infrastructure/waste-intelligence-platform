# Waste Intelligence Platform - environment template.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL / TimescaleDB
POSTGRES_PASSWORD=changeme-in-production
DB_URL=postgresql://timescale:${POSTGRES_PASSWORD}@postgres:5432/wasteintel

# Waste Intel API auth
WASTE_INTEL_API_KEY=
REQUIRE_API_KEY=false

# Set to production to make the API refuse to boot without DB_URL/API_KEY
ENVIRONMENT=development

# External APIs (optional; tools fall back to labeled simulated data)
SOCRATA_APP_TOKEN=
MTA_API_KEY=
AIRNOW_API_KEY=
OPENROUTER_API_KEY=

# Grafana (devops compose)
GF_SECURITY_ADMIN_PASSWORD=

# MQTT bridge
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
