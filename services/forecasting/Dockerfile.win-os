# WIN OS build of the pre-existing forecasting service.
#
# The original services/forecasting/Dockerfile assumes a repo-root build
# context (COPY services/forecasting/requirements.txt ...), which is how the
# legacy root docker-compose.yml builds it. WIN OS builds it with the service
# directory itself as the context (see win-os/compose.yaml), so the COPY
# sources are context-relative here. The original Dockerfile is untouched.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app.py .

EXPOSE 8002

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8002"]
